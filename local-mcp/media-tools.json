  {
    "name": "mynt_pomodoro_control",
    "description": "Start, pause or extend the timer. Reset returns action-required and must be performed in the browser UI.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "start",
            "pause",
            "extend",
            "reset"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "expectedRevision": {
          "type": "string",
          "maxLength": 16000
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "expectedRevision"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
